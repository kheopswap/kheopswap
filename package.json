{
	"name": "kheopswap",
	"version": "1.0.0",
	"description": "",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"test": "pnpm --filter web test",
		"build": "pnpm --filter web build",
		"preview": "pnpm --filter web preview",
		"dev": "pnpm --filter web dev",
		"clean": "git clean -fdx",
		"typecheck": "pnpm --filter web typecheck",
		"check": "biome check --write",
		"knip": "knip",
		"papi": "papi",
		"papi:build": "papi --whitelist papi-whitelist.ts",
		"fetch-tokens": "cd web && node --env-file-if-exists=.env.local scripts/fetch-tokens.ts",
		"generate-brand-assets": "cd web && node --experimental-transform-types scripts/generate-brand-assets.ts",
		"postinstall": "papi",
		"prepare": "simple-git-hooks"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm biome check --staged --error-on-warnings --no-errors-on-unmatched"
	},
	"keywords": [],
	"author": "Kheops",
	"license": "AGPL",
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"knip": "^6.44.1",
		"polkadot-api": "3.3.0",
		"simple-git-hooks": "^2.14.0"
	},
	"dependencies": {
		"@polkadot-api/descriptors": "file:.papi/descriptors"
	}
}
