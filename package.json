{
	"name": "kheopswap",
	"version": "1.0.0",
	"description": "",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"test": "pnpm --filter web test",
		"build": "pnpm --filter web build",
		"preview": "pnpm --filter web preview",
		"dev": "pnpm --filter web dev",
		"clean": "git clean -fdx",
		"typecheck": "pnpm --filter web typecheck",
		"check": "biome check --write",
		"knip": "knip",
		"papi": "papi",
		"papi:build": "papi --whitelist papi-whitelist.ts",
		"fetch-tokens": "cd web && node --experimental-transform-types --env-file-if-exists=.env.local scripts/fetch-tokens.ts",
		"postinstall": "papi",
		"prepare": "simple-git-hooks"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm biome check --staged --error-on-warnings --no-errors-on-unmatched"
	},
	"keywords": [],
	"author": "Kheops",
	"license": "AGPL",
	"packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"knip": "^6.32.0",
		"polkadot-api": "2.2.2",
		"simple-git-hooks": "^2.13.1"
	},
	"dependencies": {
		"@polkadot-api/descriptors": "file:.papi/descriptors"
	}
}
