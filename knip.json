			],
			"project": ["src/**/*.{ts,tsx}"],
			"ignoreDependencies": ["tailwindcss"],
			"ignore": ["src/types/helpers.ts"]
		}
	},
	"tags": ["-knipignore"],
	"ignoreExportsUsedInFile": true
}
