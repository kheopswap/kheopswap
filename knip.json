{
	"$schema": "./node_modules/knip/schema.json",
	"workspaces": {
		".": {
			"entry": ["papi-whitelist.ts"],
			"project": []
		},
		"web": {
			"entry": [
				"scripts/capture-hydration-swap-fixtures.ts",
				"scripts/capture-people-teleport-fixtures.ts",
				"scripts/fetch-tokens.ts",
				"scripts/generate-brand-assets.ts",
